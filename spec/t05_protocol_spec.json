{
  "title": "T05 frame codec contract",
  "modules": [
    {
      "name": "crc16_ccitt_byte", "feature": "t05_protocol", "rtl_path": "rtl/comm/crc16_ccitt_byte.v",
      "parameters": {"C_INITIAL_VALUE": "16'hFFFF", "C_POLYNOMIAL": "16'h1021"},
      "interfaces": {"ports": [
        {"name":"i_clk","direction":"input","width":1,"role":"clock","description":"100 MHz system clock","clock_domain":"i_clk"},
        {"name":"i_reset","direction":"input","width":1,"role":"reset","description":"Active-high project reset","clock_domain":"i_clk"},
        {"name":"i_start","direction":"input","width":1,"role":"control","description":"Accept one input byte when idle","clock_domain":"i_clk"},
        {"name":"i_clear","direction":"input","width":1,"role":"control","description":"Start this byte from the initial CRC value","clock_domain":"i_clk"},
        {"name":"i_data","direction":"input","width":8,"role":"payload","description":"Byte processed MSB first","clock_domain":"i_clk"},
        {"name":"o_busy","direction":"output","width":1,"role":"status","description":"Eight bit iterations are active","clock_domain":"i_clk"},
        {"name":"o_done","direction":"output","width":1,"role":"status","description":"One-clock completion pulse","clock_domain":"i_clk"},
        {"name":"o_crc","direction":"output","width":16,"role":"result","description":"Current CRC remainder","clock_domain":"i_clk"}
      ]},
      "clock":{"name":"i_clk","frequency_hz":100000000}, "reset":{"name":"i_reset","active":"high","synchronous":true},
      "behavior":["An accepted byte is processed MSB first in eight clocks using polynomial 0x1021.","i_clear and i_start together begin a new CRC at 0xFFFF."],
      "constraints":["Synthesizable Verilog-2001.","A new start is accepted only while o_busy is low."],
      "corner_cases":["The standard ASCII vector 123456789 produces 0x29B1."],
      "verification_cases":["CRC_STANDARD_CHECK checks 123456789 against 0x29B1."],
      "timing_diagrams":[{"id":"CRC_BYTE","title":"One byte CRC iteration","scenario":"byte","description":"Start launches eight serial CRC iterations and done pulses after the final update.","wavejson":{"signal":[{"name":"i_clk","wave":"p........."},{"name":"i_start","wave":"010......."},{"name":"o_busy","wave":"01.......0"},{"name":"o_done","wave":"0........1"}]}}]
    },
    {
      "name":"packet_decoder", "feature":"t05_protocol", "rtl_path":"rtl/comm/packet_decoder.v",
      "parameters":{"C_MAX_PAYLOAD_LENGTH":244,"C_TIMEOUT_CLKS":10000000},
      "interfaces":{"ports":[
        {"name":"i_clk","direction":"input","width":1,"role":"clock","description":"100 MHz system clock","clock_domain":"i_clk"},
        {"name":"i_reset","direction":"input","width":1,"role":"reset","description":"Active-high project reset","clock_domain":"i_clk"},
