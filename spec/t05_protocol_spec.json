        {"name":"i_frame_sequence","direction":"input","width":16,"role":"metadata","description":"Response sequence","clock_domain":"i_clk"},
        {"name":"i_frame_payload_length","direction":"input","width":8,"role":"metadata","description":"Payload byte count","clock_domain":"i_clk"},
        {"name":"i_payload_data","direction":"input","width":8,"role":"payload","description":"Streaming payload byte","clock_domain":"i_clk"},
        {"name":"i_payload_valid","direction":"input","width":1,"role":"valid","description":"Streaming payload is valid","clock_domain":"i_clk"},
        {"name":"o_payload_ready","direction":"output","width":1,"role":"ready","description":"Payload byte will be accepted","clock_domain":"i_clk"},
        {"name":"o_data","direction":"output","width":8,"role":"payload","description":"Encoded byte toward UART TX","clock_domain":"i_clk"},
        {"name":"o_data_valid","direction":"output","width":1,"role":"valid","description":"Encoded byte is valid","clock_domain":"i_clk"},
        {"name":"i_data_ready","direction":"input","width":1,"role":"ready","description":"UART TX accepts encoded byte","clock_domain":"i_clk"},
        {"name":"o_busy","direction":"output","width":1,"role":"status","description":"Frame encoding is active","clock_domain":"i_clk"},
        {"name":"o_frame_done","direction":"output","width":1,"role":"status","description":"CRC high byte was accepted","clock_domain":"i_clk"},
        {"name":"o_length_error","direction":"output","width":1,"role":"error","description":"Submitted payload length exceeds 244","clock_domain":"i_clk"}
      ]},
      "clock":{"name":"i_clk","frequency_hz":100000000}, "reset":{"name":"i_reset","active":"high","synchronous":true},
      "behavior":["Emit A5 5A, version 01, command, little-endian sequence and length, streamed payload, then little-endian CRC.","Every output byte remains stable until UART TX accepts it.","CRC is updated only for accepted bytes from VERSION through PAYLOAD."],
      "constraints":["Payload source must obey valid-ready stability.","Lengths above 244 are rejected without starting a frame."],
      "corner_cases":["Zero-length payload proceeds directly from length high to CRC low.","UART backpressure stalls all state advancement."],
      "verification_cases":["Encode the ACK golden frame.","Reject payload length 250."],
