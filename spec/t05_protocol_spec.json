      "clock":{"name":"i_clk","frequency_hz":100000000}, "reset":{"name":"i_reset","active":"high","synchronous":true},
      "behavior":["Search overlapping A5 5A SOF, then parse version, command, sequence, length, payload and little-endian CRC.","Frame valid is asserted only after CRC success and remains high until frame ready.","Up to 244 payload bytes are stored internally and exposed through a synchronous read port.","Version, command, length, CRC and inter-byte timeout errors are held on a separate valid-ready channel."],
      "constraints":["CRC covers VERSION through PAYLOAD and excludes SOF and CRC bytes.","Payload memory is not committed to the command controller before CRC success."],
      "corner_cases":["A5 A5 5A treats the second A5 as the new SOF start.","LEN above 244 is rejected.","No accepted byte for 100 ms while inside a frame reports timeout."],
      "verification_cases":["Decode GET_INFO.","Recover from overlapping SOF.","Read all bytes of READ_RESULT payload.","Reject a corrupted CRC.","Report inter-byte timeout."],
      "timing_diagrams":[{"id":"DECODE_FRAME","title":"Frame commit after CRC","scenario":"valid_frame","description":"Input bytes may pause during CRC iteration; frame valid appears only after CRC high byte matches.","wavejson":{"signal":[{"name":"i_clk","wave":"p..........."},{"name":"i_data_valid","wave":"01.0.1.0.1."},{"name":"o_data_ready","wave":"10.1.0.1.0."},{"name":"o_frame_valid","wave":"0..........1"}]}}]
    },
    {
