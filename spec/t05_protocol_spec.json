        {"name":"o_payload_read_data","direction":"output","width":8,"role":"payload","description":"Synchronous payload read data","clock_domain":"i_clk"},
        {"name":"o_payload_read_valid","direction":"output","width":1,"role":"valid","description":"Payload read response pulse","clock_domain":"i_clk"},
        {"name":"o_error_valid","direction":"output","width":1,"role":"valid","description":"Protocol error report is available","clock_domain":"i_clk"},
        {"name":"i_error_ready","direction":"input","width":1,"role":"ready","description":"Error consumer accepts report","clock_domain":"i_clk"},
        {"name":"o_error_code","direction":"output","width":8,"role":"error","description":"T03 protocol error code","clock_domain":"i_clk"},
        {"name":"o_error_command","direction":"output","width":8,"role":"error","description":"Command associated with the error","clock_domain":"i_clk"},
